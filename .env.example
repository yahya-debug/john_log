POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=john_log

DB_CONNECTION=postgres://postgres:your_password_here@localhost:5432/john_log

# Credentials for the read replica's replication login (docker-compose.yml's
# postgres/postgres-replica services). Defaults to replicator/replicator_pw if
# unset — fine for local/CI use, but change these if you're exposing this
# setup anywhere real. Not needed to run the app itself: READ_DB_CONNECTION
# below (which the app actually reads) falls back to DB_CONNECTION when unset,
# so a single Postgres with no replica configured still works.
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pw

# Optional. Where GET /logs and GET /logs/aggregate read from — the replica,
# not the primary (see README's Schema and index design). Unset = falls back
# to DB_CONNECTION, i.e. reads go to the same Postgres writes do.
# docker-compose.yml's app service sets this itself when the replica is
# running; this line only matters for running the app outside that compose
# file (e.g. `npm start` against your own Postgres).
# READ_DB_CONNECTION=postgres://postgres:your_password_here@localhost:5434/john_log

PORT=8080
RETENTION_DAYS=30
PARTITION_LOOKAHEAD_DAYS=7
RETENTION_CRON="10 0 * * *"

# Optional. Unset = disabled (unbounded). Caps concurrent GET /logs/aggregate?q=...
# requests; excess requests get 429 + Retry-After instead of degrading every
# concurrent aggregate query together — see README's Known limitations.
# AGGREGATE_Q_MAX_CONCURRENT=2